# Copy to deployment/.env and fill in. Never commit the real .env.

# Public hostname. Its DNS must point at this VPS (Caddy fetches the TLS certificate).
WEWIN_DOMAIN=wewin.example.com

# Generate with: openssl rand -hex 24   (hex only: it is embedded in a database URL)
POSTGRES_PASSWORD=change-me

# Generate with: openssl rand -base64 48
WEWIN_SECRET_KEY=change-me

# Initial owner, created on first start only. The server refuses to start if the
# password is weak (8+ characters, three of: lowercase, uppercase, digits, symbols).
WEWIN_ORGANIZATION_NAME=WeWin
WEWIN_OWNER_EMAIL=admin9531@gmail.com
WEWIN_OWNER_PASSWORD=change-me
WEWIN_OWNER_NAME=Owner

# Mail delivery for password-reset codes (without it, codes go to the server log).
WEWIN_SMTP_HOST=
WEWIN_SMTP_PORT=587
WEWIN_SMTP_USER=
WEWIN_SMTP_PASSWORD=
WEWIN_SMTP_FROM=WeWin <no-reply@wewin.example.com>
WEWIN_SMTP_STARTTLS=true

# Optional tuning
# WEWIN_WORKERS=2
# WEWIN_ACCESS_TOKEN_MINUTES=30
# WEWIN_REFRESH_TOKEN_HOURS=12
# WEWIN_REMEMBER_ME_DAYS=30
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=14
